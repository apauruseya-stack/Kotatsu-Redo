<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/card_hero"
	android:layout_width="112dp"
	android:layout_height="168dp"
	android:layout_marginHorizontal="5dp"
	android:layout_marginVertical="4dp"
	android:clickable="true"
	android:focusable="true"
	app:cardBackgroundColor="#1A1C24"
	app:cardCornerRadius="14dp"
	app:cardElevation="3dp"
	app:strokeColor="#26FFFFFF"
	app:strokeWidth="1dp">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<!-- Cover Art -->
		<org.koitharu.kotatsu.image.ui.CoverImageView
			android:id="@+id/iv_cover"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:scaleType="centerCrop"
			tools:ignore="ContentDescription" />

		<!-- Top-to-Bottom Scrim: light at top, dark at bottom -->
		<View
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@drawable/scrim_continue_hero_card" />

		<!-- Top-Left Glass Chapter Pill -->
		<LinearLayout
			android:id="@+id/layout_chapter_pill"
			android:layout_width="wrap_content"
			android:layout_height="19dp"
			android:layout_gravity="top|start"
			android:layout_margin="6dp"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:paddingHorizontal="6dp"
			android:background="@drawable/bg_glass_chapter_pill">

			<!-- Static Green Indicator Dot with soft glow -->
			<View
				android:layout_width="4dp"
				android:layout_height="4dp"
				android:layout_marginEnd="4dp"
				android:background="@drawable/bg_green_active_dot" />

			<TextView
				android:id="@+id/tv_chapter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="#FFFFFF"
				android:textSize="9sp"
				android:textStyle="bold"
				android:includeFontPadding="false"
				tools:text="Ch. 74" />
		</LinearLayout>

		<!-- Top-Right Pulsing Play Button -->
		<FrameLayout
			android:id="@+id/layout_play_button"
			android:layout_width="28dp"
			android:layout_height="28dp"
			android:layout_gravity="top|end"
			android:layout_margin="5dp">

			<!-- Pulsing Halo View (Driven by shared animator) -->
			<View
				android:id="@+id/view_play_halo"
				android:layout_width="28dp"
				android:layout_height="28dp"
				android:layout_gravity="center"
				android:background="@drawable/bg_halo_play"
				android:visibility="gone"
				tools:visibility="visible" />

			<!-- Glass Play Circle -->
			<ImageView
				android:layout_width="23dp"
				android:layout_height="23dp"
				android:layout_gravity="center"
				android:background="@drawable/bg_glass_play_circle"
				android:padding="5dp"
				android:src="@drawable/ic_play"
				app:tint="#FFFFFF"
				tools:ignore="ContentDescription" />
		</FrameLayout>

		<!-- Bottom Overlay: Title, Progress Bar, Percentage -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom"
			android:orientation="vertical"
			android:paddingHorizontal="7dp"
			android:paddingBottom="7dp">

			<TextView
				android:id="@+id/tv_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:maxLines="2"
				android:ellipsize="end"
				android:textColor="#FFFFFF"
				android:textSize="10.5sp"
				android:textStyle="bold"
				android:lineSpacingMultiplier="1.15"
				android:shadowColor="#B3000000"
				android:shadowDx="0"
				android:shadowDy="1"
				android:shadowRadius="4"
				tools:text="Streaming My Second Life" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="5dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<!-- Progress Bar (3.5dp height with rounded ends) -->
				<ProgressBar
					android:id="@+id/pb_progress"
					style="?android:attr/progressBarStyleHorizontal"
					android:layout_width="0dp"
					android:layout_height="3.5dp"
					android:layout_weight="1"
					android:max="100"
					android:progress="74"
					android:progressDrawable="@drawable/progress_continue_hero" />

				<TextView
					android:id="@+id/tv_percent"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="5dp"
					android:textColor="#D9FFFFFF"
					android:textSize="9sp"
					android:textStyle="bold"
					android:shadowColor="#80000000"
					android:shadowDx="0"
					android:shadowDy="1"
					android:shadowRadius="3"
					tools:text="98%" />
			</LinearLayout>
		</LinearLayout>

	</FrameLayout>

</com.google.android.material.card.MaterialCardView>
